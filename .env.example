# ==============================================================================
# SPANDAN HOSPITAL WEB — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Note: Document variable names with dummy placeholders only. NEVER put real secrets here.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public API gateway URL (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Anon Key (Governed strictly by PostgreSQL Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Service Role Secret (STRICTLY SERVER-ONLY - Used in Server Actions)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# Anti-Spam & Bot Verification (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Public Turnstile site key (Safe for browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# Turnstile private secret key (Server-only validation)
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# ------------------------------------------------------------------------------
# Transactional Notifications (Resend)
# ------------------------------------------------------------------------------
# Resend API key (Server-only email dispatch)
RESEND_API_KEY="your-resend-api-key"

# Hospital notification recipient inbox (e.g., reception desk)
HOSPITAL_ALERT_EMAIL="desk@spandanhospital.in"

# Notification sender email identity
NOTIFICATION_SENDER_EMAIL="Spandan Hospital <notifications@spandanhospital.in>"
